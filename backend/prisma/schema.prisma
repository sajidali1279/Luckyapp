  @@index([customerId])
  @@index([createdAt])
  @@map("employee_ratings")
}

// ─── Job Applications ─────────────────────────────────────────────────────────

model JobApplication {
  id           String            @id @default(uuid())
  name         String
  phone        String
  email        String?
  position     String            // CASHIER | ASSISTANT_MANAGER | STORE_MANAGER | FOOD_PREP | NIGHT_SHIFT | FUEL_ATTENDANT
  storeId      String?
  availability Json              // { type: "FULL_TIME"|"PART_TIME", shifts: string[] }
  experience   String?
  message      String?

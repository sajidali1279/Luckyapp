generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum StoreRequestType {
  LOW_STOCK
  STORE_SUPPLIES
  CUSTOMER_REQUESTED_PRODUCT
  WORK_ORDER
}

enum StoreRequestPriority {
  LOW
  MEDIUM
  HIGH
}

enum StoreRequestStatus {
  PENDING
  ACKNOWLEDGED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum ShiftType {
  OPENING
  MIDDLE
  CLOSING
}

enum ShiftRequestType {
  TIME_OFF
  FILL_IN
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum Role {
  DEV_ADMIN    // Developer (you) — full access + billing
  SUPER_ADMIN  // LuckyStop HQ — all stores, offers, banners
  STORE_MANAGER // Per-store management
  EMPLOYEE     // Scan QR, upload receipt, grant points
  CUSTOMER     // Mobile app user
}

enum BillingType {
  MONTHLY_SUBSCRIPTION
  PER_TRANSACTION
  HYBRID
  CUSTOM
}

enum TransactionStatus {
  PENDING    // Waiting for receipt upload
  FLAGGED    // Suspicious — receipt uploaded but points held for manager review
  APPROVED   // Points granted
  REJECTED   // Rejected by admin/auto
  VOIDED     // Was APPROVED; undone after the fact, the credited points clawed back
  CANCELLED  // Never finished: the cashier stopped before the receipt photo, so nothing was credited (2026-10-18). Not a decision and
             // never shown to the customer: no push, and HQ and the managers see it only in its own filter.
}

enum OfferType {
  ALL_STORES   // Applies to all 14 stores
  SPECIFIC_STORE
}

// A store manager's request for a cashback promotion at their store, until HQ decides
enum OfferRequestStatus {
  PENDING
  APPROVED
  DECLINED
  WITHDRAWN
}

enum ProductCategory {
  GROCERIES
  FROZEN_FOODS
  FRESH_FOODS
  GAS
  DIESEL
  HOT_FOODS
  OTHER
}

enum ApplicationStatus {
  NEW
  REVIEWED
  INTERVIEW
  HIRED
  REJECTED
}

enum ProductRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum OrderItemPriority {
  URGENT
  NORMAL
  LOW
}

enum OrderListStatus {
  OPEN    // Active — manager is building this list
  CLOSED  // Order placed / delivered
}

enum OrderListItemStatus {
  PENDING   // On the list, not yet ordered
  ORDERED   // Manager confirmed ordered from supplier
  RECEIVED  // Arrived at store
  REMOVED   // Removed from list (soft delete)
}

enum OrderItemSource {
  MANAGER           // Added directly by manager
  EMPLOYEE_REQUEST  // Accepted from an employee request
  CUSTOMER_REQUEST  // Auto-added when manager accepts a customer product request
}

enum EmployeeRequestStatus {
  PENDING   // Not yet reviewed by manager
  REVIEWED  // Manager has processed all lines
}

enum RequestLineStatus {
  PENDING   // Not yet reviewed
  ACCEPTED  // Added to active order list
  REJECTED  // Rejected with reason
}

enum RejectionReason {
  NO_SUPPLIER   // No supplier available
  OUT_OF_BUDGET // Out of budget
  IN_STOCK      // Already in stock
  DUPLICATE     // Already on the list
  OTHER         // See rejectionNote
}

enum CategoryStatus {
  PENDING   // Awaiting DevAdmin review
  APPROVED  // Shown in category dropdowns
  REJECTED  // Hidden / removed
}

enum EmployeeRequestType {
  LOW_STOCK         // Running low on an item
  CUSTOMER_REQUEST  // Customer asked for this product
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  DIAMOND
  PLATINUM
}

enum PromoStatus {
  PENDING    // Customer submitted, awaiting DevAdmin review
  APPROVED   // DevAdmin published — visible to all customers
  REJECTED   // DevAdmin rejected
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  phone           String   @unique
  name            String?
  role            Role     @default(CUSTOMER)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // The language the person uses the app in ("en" or "es"), sent by the app; promotion pushes use it. null = English.
  language        String?
  // Their birthday, month and day only (no year), if they gave it in the app: birthday-month promotions
  birthMonth      Int?
  birthDay        Int?
  // Refer a friend (2026-10-09): the code this customer shares; made the first time they open Invite friends
  referralCode    String?  @unique

  // Auth — phone + PIN
  pinHash         String?
  pinHistory      String[] // last 3 PIN hashes (prevent reuse)
  isProfileComplete Boolean @default(false)

  // Tier system
  tier            Tier     @default(BRONZE)
  periodPoints    Float    @default(0)   // points earned this period (in dollars, × 100 = pts for display)
  tierPeriod      String   @default("2026-H1")  // "YYYY-H1" or "YYYY-H2"

  // Account recovery
  email           String?  @unique
  emailVerified   Boolean  @default(false)

  // Login rate limiting
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // How many sign-in lockouts in a row (each one longer than the last). A good sign-in or a PIN reset sets it back to 0.
  lockoutLevel        Int       @default(0)
  // Session tokens issued before this moment are refused. Set when a PIN is reset, so a lost phone's session ends.
  sessionsValidAfter  DateTime?
  // Set on every successful sign-in (best effort, never blocks the sign-in itself). Null means never signed in.
  lastSignInAt        DateTime?
  previousSignInAt    DateTime? // the sign-in before the last one, shown on the admin profile so someone else's use stands out
  // HQ emails this person has switched off (MORNING_SUMMARY, WEEKLY_SUMMARY, LARGE_SALE, MISSING_POINTS, STORE_ALERT); empty = all of them
  emailAlertsOff      String[]  @default([])

  // Customer-specific
  qrCode          String?  @unique
  pointsBalance   Float    @default(0)
  avatarUrl       String?
  age21Confirmed  Boolean  @default(false)
  // Said "not now" at an age-restricted prompt. Distinct from never having
  // been asked: once declined, restricted content stays hidden rather than
  // prompting again on every encounter, until the customer opts in from
  // Profile (which calls the same confirm action age21Confirmed uses).
  age21Declined   Boolean  @default(false)

  // Multi-store manager flag — when true, STORE_MANAGER bypasses per-store access check
  allStoresAccess      Boolean  @default(false)

  // Fraud / restriction
  fraudNote            String?  // reason stored when account is restricted for fraud

  // Relations
  storeRoles           UserStoreRole[]
  disputes             PointsDispute[]  @relation("DisputeSubmitter")
  resolvedDisputes     PointsDispute[]  @relation("DisputeResolver")
  pointsEarned         PointsTransaction[]  @relation("PointsEarner")
  pointsGranted        PointsTransaction[]  @relation("PointsGranter")
  pointsServed         PointsTransaction[]  @relation("PointsServer")
  pointLots            PointLot[]
  pointLotUses         PointLotUse[]
  redemptions          Redemption[]
  creditRedemptions    CreditRedemption[]   @relation("CustomerRedemptions")
  processedRedemptions CreditRedemption[]   @relation("ProcessorRedemptions")
  pushTokens           PushToken[]
  notifications        UserNotification[]
  tierBenefitClaims         TierBenefitClaim[]
  welcomeBonusClaims        WelcomeBonusClaim[]
  catalogRedemptions        CatalogRedemption[]  @relation("CatalogCustomer")
  processedCatalogRedemptions CatalogRedemption[] @relation("CatalogProcessor")
  shiftTemplates       ShiftTemplate[]      @relation("EmployeeShifts")
  shiftRequests        ShiftRequest[]       @relation("EmployeeRequests")
  checkIns             StaffCheckIn[]       @relation("StaffCheckIns")
  receiptScans         ReceiptScan[]        @relation("ReceiptScans")
  chatMessages         ChatMessage[]
  chatReads            ChatRead[]
  submittedStoreRequests StoreRequest[]
  productRequests        ProductRequest[] @relation("CustomerProductRequests")
  respondedProductRequests ProductRequest[] @relation("ProductRequestResponder")
  businessPromotions     BusinessPromotion[]
  supportThreads       SupportThread[]
  supportMessages      SupportMessage[]
  ratingsGiven         EmployeeRating[] @relation("RatingsGiven")
  ratingsReceived      EmployeeRating[] @relation("RatingsReceived")
  // Order list system
  openedOrderLists     OrderList[]      @relation("OrderListsOpened")
  closedOrderLists     OrderList[]      @relation("OrderListsClosed")
  addedOrderListItems  OrderListItem[]  @relation("OrderListItemsAdded")
  managedPrintJobs     PrintJob[]       @relation("PrintJobsPrinted")
  approvedCategories   OrderCategory[]  @relation("CategoryApprovals")
  submittedItemRequests EmployeeItemRequest[] @relation("EmployeeRequestsSubmitted")
  reviewedItemRequests  EmployeeItemRequest[] @relation("EmployeeRequestsReviewed")
  hotFoodOrders         HotFoodOrder[]        @relation("HotFoodOrdersPlaced")
  jobOpenings           JobOpening[]
  dailyReports          DailyReport[]         @relation("DailyReportsSubmitted")
  adminNotices          AdminNotice[]
  referralsMade         Referral[]            @relation("Referrer")
  referredBy            Referral?             @relation("ReferredFriend")
  supportNotes          CustomerNote[]        @relation("NoteCustomer")

  @@map("users")
}

model Store {
  id          String   @id @default(uuid())
  name        String
  address     String
  city        String
  state       String
  zipCode     String
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Billing (managed by DevAdmin only)
  billingType       BillingType @default(MONTHLY_SUBSCRIPTION)
  subscriptionPrice Float       @default(99.00)
  transactionFeeRate Float      @default(0.02)

  // Scheduling
  shiftsPerDay      Int         @default(3)  // 2 or 3 shifts per day

  // Location (for customer proximity detection)
  latitude          Float?
  longitude         Float?

  // Age-restricted store gate (21 = requires 21+ confirmation before showing content)
  minimumAge        Int?

  // Feature flags
  hotFoodEnabled    Boolean  @default(true)

  // Standing order instructions — shown to whoever opens the store's order list
  // (admin web or mobile), persists across list close/auto-reopen cycles
  orderInstructions String?

  // The label printer's fine-tune for US Letter sheets, in mm (minus = up / left). Per store because the offset belongs to the
  // store's printer, and staff print from their own phones.
  labelNudgeDown      Float     @default(0)
  labelNudgeRight     Float     @default(1)
  // The label size and the space between columns and rows on that printer (mm). They start at what prints right on Avery 5160
  // sheets on HQ's printer (2026-10-02), the same starting numbers the app and the admin print page use.
  labelWidth          Float     @default(65)
  labelHeight         Float     @default(25)
  labelGapX           Float     @default(4.9)
  labelGapY           Float     @default(0.6)
  // The whole sheet drawn this % of its size, for a phone print app that shrinks the page (100 = as set)
  labelScale          Float     @default(100)
  labelNudgeUpdatedAt DateTime?
  labelNudgeUpdatedBy String?

  // Gas prices (updated daily by admins). Each commodity tracks its own
  // updatedAt so mobile can show a "change needed" indicator independently
  // for gas vs diesel — a diesel-only price edit shouldn't flag gas as changed.
  gasPricePerGallon      Float?
  dieselPricePerGallon   Float?
  gasPriceUpdatedAt      DateTime?
  dieselPriceUpdatedAt   DateTime?

  // Per-store category availability (empty = all categories enabled)
  enabledCategories ProductCategory[]

  // Printer agent authentication
  apiKey            String?     @unique

  // Relations
  userRoles         UserStoreRole[]
  transactions      PointsTransaction[]
  creditRedemptions CreditRedemption[]
  offers            Offer[]
  challenges        Challenge[]
  offerRequests     OfferRequest[]
  banners           Banner[]
  billing           BillingRecord[]
  receiptTokens     ReceiptToken[]
  shiftTemplates    ShiftTemplate[]
  shiftRequests     ShiftRequest[]
  staffCheckIns     StaffCheckIn[]
  receiptScans      ReceiptScan[]
  chatMessages      ChatMessage[]
  chatReads         ChatRead[]
  storeRequests     StoreRequest[]
  catalogRedemptions CatalogRedemption[]
  employeeRatings    EmployeeRating[]
  keywordMappings    StoreKeywordMapping[]
  jobApplications    JobApplication[]
  storeLabels        StoreLabel[]
  jobOpenings        JobOpening[]
  productRequests    ProductRequest[]
  orderLists         OrderList[]
  printJobs          PrintJob[]
  employeeItemRequests EmployeeItemRequest[]
  pointsDisputes       PointsDispute[]
  hotFoodMenuItems      HotFoodMenuItem[]
  hotFoodOrders         HotFoodOrder[]
  hotFoodCatalogStores  HotFoodCatalogStore[]
  dailyReports          DailyReport[]
  dailyTasks            DailyTask[]
  adminNotices          AdminNotice[]
  rewardItems           RedemptionCatalogItem[]
  pdiInvoices           PdiInvoice[]
  // Store hours: regular weekly schedule (StoreHours) plus date-specific
  // overrides for holidays etc. (StoreHoliday), see both models below.
  storeHours            StoreHours[]
  storeHolidays         StoreHoliday[]
  hotFoodHours          HotFoodHours[]

  @@map("stores")
}

// Regular weekly hours: one row per day of week. isOpen24Hours skips
// open/close times entirely; isClosed means the store doesn't open that
// day at all (e.g. closed Sundays).
model StoreHours {
  id            String     @id @default(uuid())
  storeId       String
  dayOfWeek     DayOfWeek
  isClosed      Boolean    @default(false)
  isOpen24Hours Boolean    @default(false)
  openTime      String?    // "HH:mm", 24-hour clock
  closeTime     String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
  @@map("store_hours")
}

// When hot food can be ordered at a store, one row per day of the week (the same shape as StoreHours). A store with no rows
// follows its own opening hours. Ordering is also closed whenever the store itself is closed (holidays included).
model HotFoodHours {
  id            String    @id @default(uuid())
  storeId       String
  dayOfWeek     DayOfWeek
  isClosed      Boolean   @default(false)
  isOpen24Hours Boolean   @default(false)
  openTime      String?   // "HH:mm", 24-hour clock; a closing time earlier than the opening time runs past midnight
  closeTime     String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
  @@map("hot_food_hours")
}

// Date-specific override of the regular weekly schedule: holidays, one-off
// closures, etc. A row here for a given date always wins over StoreHours.
model StoreHoliday {
  id            String   @id @default(uuid())
  storeId       String
  date          DateTime @db.Date
  label         String   // e.g. "Thanksgiving", "Christmas Day"
  isClosed      Boolean  @default(false)
  isOpen24Hours Boolean  @default(false)
  openTime      String?
  closeTime     String?
  createdAt     DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@map("store_holidays")
}

// Per-store POS keyword → Lucky Stop category mappings
// Printer-agent fetches these so store-specific labels are classified correctly
model StoreKeywordMapping {
  id        String          @id @default(uuid())
  storeId   String
  keyword   String
  category  ProductCategory
  createdAt DateTime        @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, keyword])
  @@map("store_keyword_mappings")
}

// Links employees/managers to their specific stores
model UserStoreRole {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  role      Role
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@map("user_store_roles")
}

// ─── Points System ────────────────────────────────────────────────────────────

model PointsTransaction {
  id              String            @id @default(uuid())
  customerId      String
  grantedById     String
  storeId         String
  purchaseAmount  Float
  pointsAwarded   Float             // cashback credited to customer
  devCut          Float             // dev's cut of cashback issued (taken at grant time)
  storeCost       Float             // full cashback issued — store bears this cost
  cashbackRate    Float             @default(0.05) // rate used at time of grant
  category        ProductCategory   @default(OTHER)
  status          TransactionStatus @default(PENDING)
  receiptImageUrl  String?
  // SHA-256 of the receipt file. Not unique: the lines of one multi-item sale (gas + groceries) share their receipt photo, and a
  // unique index refused the second line ("That already exists", the cashier could never finish the sale, 2026-10-17). Reuse of a
  // photo on any OTHER sale is refused by uploadReceipt (points.controller.ts) and the receipt scans.
  receiptImageHash String?
  notes            String?
  isGas             Boolean @default(false)
  gasGallons        Float?
  gasPricePerGallon Float?
  gasBonusPoints    Float   @default(0)
  fraudFlags        String?           // JSON array of fraud flag reasons
  isTestData        Boolean @default(false)
  voidedAt          DateTime?         // when an APPROVED sale was voided (undone after the fact)
  voidedById        String?           // the admin who voided it (not a relation: a rare admin action, looked up by id when shown)
  voidReason        String?           // required when voiding; shown nowhere the customer can see it
  // The promotion that raised this sale's cashback (only one applies to a sale) and how much of the cashback it added, after the
  // 10% ceiling. Recorded from 2026-09-28; older sales have neither.
  offerId           String?
  offerCashback     Float?
  // A challenge reward (2026-10-05, utils/challenges.ts): the cashback a customer earned by completing a challenge, credited as its
  // own approved line (no purchase), and the sale whose approval completed it. Voiding this line takes the reward back.
  challengeId       String?
  rewardForSaleId   String?
  // A referral reward (2026-10-09, utils/referrals.ts): like a challenge reward, its own approved line with no purchase, never a
  // sale. Both the person who shared and the friend get one, at the store of the friend's qualifying purchase.
  referralId        String?
  // The employee who actually served the customer, when HQ entered the sale for them from photos (2026-10-15, admin Grant & Redeem
  // page, for an employee with no phone). grantedById is then HQ. Cashier stats and ratings go to servedById when it is set.
  servedById        String?
  // The lines of one sale (groceries + hot food + gas, 2026-10-17): every line of a sale with more than one line carries the id of its
  // first line, so HQ's Transactions page shows them as one sale. Null for a one-line sale and for sales made before.
  saleId            String?
  // A sale that was never finished (status CANCELLED, 2026-10-18): when, and why. CASHIER = the cashier pressed Cancel, NEW_SCAN = the
  // cashier started the same customer's sale again, TIMEOUT = no receipt photo within 30 minutes, MANAGER = cleared by a manager or HQ.
  cancelledAt       DateTime?
  cancelReason      String?
  // A receipt the customer left behind, added by the cashier to that customer's sale from the Recent tab after they had gone (2026-10-18):
  // no QR scan, so only to their own sale of the last hour, with a new receipt photo, a few a day, and held for a manager from HQ's amount.
  addOn             Boolean   @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customer    User  @relation("PointsEarner", fields: [customerId], references: [id])
  offer       Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  challenge   Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  grantedBy   User  @relation("PointsGranter", fields: [grantedById], references: [id])
  servedBy    User? @relation("PointsServer", fields: [servedById], references: [id])
  store       Store @relation(fields: [storeId], references: [id])
  rating      EmployeeRating?
  disputes    PointsDispute[]

  @@index([customerId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
  @@index([storeId, status, createdAt])
  @@index([offerId])
  @@index([challengeId])
  @@index([rewardForSaleId])
  @@index([referralId])
  @@index([servedById])
  @@index([receiptImageHash])
  @@index([saleId])
  @@map("points_transactions")
}

// A challenge (2026-10-05, utils/challenges.ts): "Spend $30 on groceries this week, get $3 back" (SPEND: target in dollars, once per
// customer) or "Every 5th coffee earns $1" (VISITS: target purchases, each at least minPurchase; repeats). Only APPROVED sales count,
// at the moment they are approved, so a sale later rejected never counts. The reward is credited as an approved PointsTransaction.
model Challenge {
  id            String           @id @default(uuid())
  kind          String           // SPEND | VISITS | WINBACK (2026-10-16: a one-off gift to quiet customers, utils/winBack.ts; never runs as a challenge)
  title         String
  titleEs       String?
  description   String           @default("")
  descriptionEs String?
  category      ProductCategory? // null = any purchase
  storeId       String?          // null = every store
  target        Float            // SPEND: dollars to spend; VISITS: how many purchases
  minPurchase   Float?           // VISITS: a purchase counts when it is at least this
  reward        Float            // dollars of cashback when it is reached
  repeats       Boolean          @default(false)   // earn it again after each target (VISITS); SPEND is once
  audience      String           @default("EVERYONE")   // as Offer (utils/offerAudience.ts)
  audienceTier  Tier?
  audienceDays  Int?
  quietDays     Int?             // WINBACK: sent to customers with no purchase for this many days
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean          @default(true)
  announcedAt   DateTime?
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  store         Store?              @relation(fields: [storeId], references: [id])
  progress      ChallengeProgress[]
  rewards       PointsTransaction[]

  @@index([isActive, endDate])
  @@map("challenges")
}

// One customer's way through a challenge: what counts since their last reward, and how many times they have earned it.
model ChallengeProgress {
  id          String    @id @default(uuid())
  challengeId String
  customerId  String    // a plain id: the customer's history stays with the challenge
  progress    Float     @default(0)
  timesEarned Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, customerId])
  @@index([customerId])
  @@map("challenge_progress")
}

// ─── Tier Cashback Rates (DevAdmin configurable) ─────────────────────────────
// Primary rate driver: customer's tier determines base cashback %
// Bronze=1%, Silver=2%, Gold=3%, Diamond=4%, Platinum=5% (all configurable)

model TierCashbackRate {
  tier              Tier     @id
  cashbackRate      Float    // percentage cashback for all categories (e.g. 0.01 = 1%)
  gasCentsPerGallon Float?   // if set: flat ¢/gallon for GAS/DIESEL instead of percentage (e.g. 3.0 = 3¢/gal)
  pointsThreshold   Float?   // minimum period earnings in dollars to reach this tier (null = use hardcoded default)
  updatedAt         DateTime @updatedAt

  @@map("tier_cashback_rates")
}

// ─── Category Cashback Rates (additive bonus on top of tier base rate per category) ─

model CategoryRate {
  category     ProductCategory @id
  cashbackRate Float           @default(0.05)
  updatedAt    DateTime        @updatedAt

  @@map("category_rates")
}

// Tracks when a customer uses their credit balance in-store
model CreditRedemption {
  id          String   @id @default(uuid())
  customerId  String
  storeId     String
  amount      Float                       // Credits redeemed
  devCut      Float    @default(0)        // Platform fee (% of redeemed amount)
  processedBy String
  createdAt   DateTime @default(now())

  customer  User  @relation("CustomerRedemptions", fields: [customerId], references: [id])
  store     Store @relation(fields: [storeId], references: [id])
  processor User  @relation("ProcessorRedemptions", fields: [processedBy], references: [id])

  @@index([customerId])
  @@index([createdAt])
  @@map("credit_redemptions")
}

// ─── Offers & Promotions ──────────────────────────────────────────────────────

model Offer {
  id          String      @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  type        OfferType   @default(ALL_STORES)
  storeId     String?
  category    ProductCategory?
  bonusRate              Float?  // bonus for ALL tiers equally — OR max value when tierBonusRates is set (used for ordering)
  tierBonusRates         Json?   // per-tier bonus override: {"BRONZE": 0.03, "GOLD": 0.01, ...} — wins over bonusRate per tier
  gasBonusCentsPerGallon Float?  // ¢/gallon bonus for GAS/DIESEL offers (used instead of bonusRate when in per-gallon mode)
  dealText               String? // price deal label e.g. "2 for $5" (display only)
  // The same words in Spanish (2026-10-05): the app shows them to customers who use it in Spanish, and their pushes use titleEs.
  // Optional: without them a Spanish reader sees the English.
  titleEs                String?
  descriptionEs          String?
  dealTextEs             String?
  requires21  Boolean     @default(false) // blurred/hidden until the customer self-declares 21+
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean     @default(true)
  // Happy hours (utils/offerHours.ts): pays only on sales inside them, store time. No times = all day. days 0 = Sun .. 6 = Sat, empty = every day.
  happyDays   Int[]       @default([])
  happyFrom   String?     // "15:00"
  happyTo     String?     // "18:00"; at or before happyFrom = runs past midnight
  // The 10 AM push on the last day to the people it was announced to (promotions of 3+ days); HQ can switch it off
  lastDayReminder   Boolean   @default(true)
  lastDayRemindedAt DateTime?
  // Who it is for (2026-10-05, utils/offerAudience.ts): EVERYONE, TIER_UP (audienceTier and above), LAPSED (no approved purchase in
  // audienceDays, default 30: win-back), NEW (joined within audienceDays, default 14) or BIRTHDAY (their birthday month). Only they see
  // it, are told about it, and are paid it.
  audience           String    @default("EVERYONE")
  audienceTier       Tier?
  audienceDays       Int?
  // Limits (utils/offerBudget.ts): the most extra cashback it pays in all (dollars) and per customer per store day. When the budget is
  // used up it stops paying and showing (budgetReachedAt), and HQ is told; raising the budget starts it again.
  budgetCap           Float?
  dailyCapPerCustomer Float?
  budgetReachedAt     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sales PointsTransaction[]   // the sales it raised (recorded from 2026-09-28)
  store Store? @relation(fields: [storeId], references: [id])
  fromRequest OfferRequest?   // the manager's request it was approved from, if any

  @@index([isActive, startDate, endDate])
  @@index([storeId])
  @@map("offers")
}

// A store manager asks HQ for a cashback promotion at their store (they cannot post cashback themselves). HQ can change it, then approves
// (which creates the real Offer) or declines with a reason; the manager is told either way. Kept apart from Offer so nothing pending can
// ever pay or be shown to customers.
model OfferRequest {
  id                     String             @id @default(uuid())
  storeId                String
  requestedById          String             // a plain id (no link), so removing a staff account is not blocked by its requests
  requestedByName        String?
  title                  String
  description            String             @default("")
  category               ProductCategory?
  bonusRate              Float?
  tierBonusRates         Json?
  gasBonusCentsPerGallon Float?
  requires21             Boolean            @default(false)
  startDate              DateTime
  endDate                DateTime
  happyDays              Int[]              @default([])
  happyFrom              String?
  happyTo                String?
  note                   String?            // the manager's reason, for HQ
  status                 OfferRequestStatus @default(PENDING)
  decidedById            String?
  decidedByName          String?
  decidedAt              DateTime?
  declineReason          String?
  offerId                String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  offer Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([storeId])
  @@map("offer_requests")
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  storeId   String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  // Shown from / until (2026-10-16): the start of the first store day and the end of the last; empty = from now / no end
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store Store? @relation(fields: [storeId], references: [id])

  @@index([isActive, storeId])
  @@map("banners")
}

enum LabelTemplate {
  CLASSIC_RED_BLACK
  CHRISTMAS_WINTER
  SUMMER
  CLEARANCE
  INDEPENDENCE_DAY
  HALLOWEEN
  PREMIUM
}

// The chain-wide catalog fact — name, barcode, template, and a BASE price.
// Per-store pricing and per-store print status live on StoreLabel, not
// here — a store's effective price is always
// storeLabel?.priceText ?? label.priceText (see resolveEffectivePrice).
model Label {
  id               String        @id @default(uuid())
  productName      String
  priceText        String?       // was required — null means "known product, price not set yet" (e.g. created by a scan, not a human)
  brand            String?       // parity with ScannedProduct.brand, carried through on sync
  dealText         String?       // chain-wide only, not store-overridable (see design spec for why)
  barcode          String?       // the physical product's own barcode (UPC/EAN/etc) for order lookups — independent of priceText/dealText
  category         String?       // freeform, same approval pipeline as Order List/Stock Request (OrderCategory) — not constrained by an enum here
  template         LabelTemplate @default(CLASSIC_RED_BLACK)
  dealHiddenInApp  Boolean       @default(false) // a label's deal shows in the customer app's Today's Deals at stores that carry it, unless HQ hides it
  createdByStoreId String?       // which store first created this catalog entry — history only, no longer drives print-queue membership
  createdById      String?       // which user created this. Set once at creation, never changed by edits.
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  storeLabels StoreLabel[]
  rewards     RedemptionCatalogItem[]   // rewards whose points follow this item's price

  @@index([createdByStoreId])
  @@map("labels")
}

// One store's own copy of a catalog Label — an optional price override and
// its own independent print status. priceText null = inherit Label's base
// price. printedAt null = this store still needs to print it.
model StoreLabel {
  id                String    @id @default(uuid())
  labelId           String
  storeId           String
  priceText         String?
  overrideExpiresAt DateTime? // when set, the price-expiry cron auto-reverts this override back to the base price once it passes — meaningless without priceText also set, cleared whenever priceText is
  printedAt         DateTime?
  everPrinted       Boolean   @default(false) // set once, true forever — printedAt alone resets on every reprint-triggering edit, so this is the only way to tell "never printed" (new) apart from "was printed, now stale" (needs reprint)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([labelId, storeId])
  @@index([storeId, printedAt])
  @@index([overrideExpiresAt])
  @@map("store_labels")
}

// ─── Rewards (future catalog) ─────────────────────────────────────────────────

model Reward {
  id            String   @id @default(uuid())
  name          String
  description   String
  imageUrl      String?
  pointsCost    Float
  isActive      Boolean  @default(true)
  stockLimit    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  redemptions Redemption[]

  @@map("rewards")
}

model Redemption {
  id          String   @id @default(uuid())
  customerId  String
  rewardId    String
  pointsSpent Float
  redeemedAt  DateTime @default(now())
  verifiedAt  DateTime?
  verifiedBy  String?

  customer User   @relation(fields: [customerId], references: [id])
  reward   Reward @relation(fields: [rewardId], references: [id])

  @@index([customerId])
  @@index([redeemedAt])
  @@map("redemptions")
}

// ─── Billing (DevAdmin only) ──────────────────────────────────────────────────

model BillingRecord {
  id          String   @id @default(uuid())
  storeId     String?  // null = chain-wide charge (billed to the SuperAdmin/chain as a whole, not one store)
  billingType BillingType
  amount      Float
  period      String
  notes       String?  // JSON: full compound breakdown (rates, categories, fee split) OR { description } for a manual/CUSTOM charge
  isPaid      Boolean  @default(false)
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id])

  // Also a partial unique index made in SQL (migration 20261031120000_billing_one_usage_bill_per_month): one usage bill per store
  // and month, extra charges (CUSTOM) excluded. Prisma cannot describe it, so never let a generated migration drop it.
  @@map("billing_records")
}

// ─── Receipt QR Tokens (printer agent → customer self-grant) ─────────────────

model ReceiptToken {
  id        String    @id @default(uuid())
  storeId   String
  txRef     String    // POS transaction reference — prevents duplicate QR generation
  total     Float
  items     String    // JSON: [{category: ProductCategory, amount: number}]
  usedBy    String?   // customer userId who claimed it
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, txRef])
  @@index([expiresAt])
  @@map("receipt_tokens")
}

// ─── Platform Config (DevAdmin key-value store) ───────────────────────────────

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

// ─── Audit Log (DevAdmin fraud monitoring) ───────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorName  String?
  actorRole  String
  action     String   // CREATE_OFFER, DELETE_OFFER, CREATE_BANNER, DELETE_BANNER, GRANT_POINTS, REJECT_TRANSACTION, REDEEM_CREDITS, CREATE_STAFF, TOGGLE_USER, RESET_PIN, SELF_GRANT
  entity     String   // offer, banner, transaction, staff, user
  entityId   String?
  details    String?  // JSON: context fields (amounts, names, etc.)
  storeId    String?
  storeName  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([storeId])
  @@index([action])
  @@map("audit_logs")
}

// ─── Scheduling ───────────────────────────────────────────────────────────────

model ShiftTemplate {
  id         String    @id @default(uuid())
  employeeId String
  storeId    String
  dayOfWeek  DayOfWeek
  shiftType  ShiftType
  startTime  String    // "06:00", "10:00", or "14:00"
  endTime    String    // "14:00", "18:00", or "22:00"
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee User  @relation("EmployeeShifts", fields: [employeeId], references: [id], onDelete: Cascade)
  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, storeId, dayOfWeek])
  @@index([storeId])
  @@index([employeeId])
  @@map("shift_templates")
}

model ShiftRequest {
  id          String           @id @default(uuid())
  employeeId  String
  storeId     String
  requestType ShiftRequestType
  date        DateTime
  shiftType   ShiftType
  status      RequestStatus    @default(PENDING)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  employee User  @relation("EmployeeRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
  @@index([employeeId])
  @@map("shift_requests")
}

// Where a staff member is working (2026-10-11): recorded when they open the app during a shift, from which of their stores the phone is
// at (worked out on the phone: no coordinates are sent). AUTO = at the store the schedule has them at; CHOSEN = they told the app
// which store, because they were at another of their stores. The latest one of the store day counts (utils/staffCheckIn.ts).
model StaffCheckIn {
  id               String   @id @default(uuid())
  userId           String
  storeId          String
  storeDay         String   // the store day, "YYYY-MM-DD" (Central)
  scheduledStoreId String?  // where the schedule had them then; null when they were not scheduled
  method           String   // AUTO | CHOSEN
  distanceFeet     Int?     // how far from the store the phone was
  createdAt        DateTime @default(now())

  user  User  @relation("StaffCheckIns", fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId, storeDay])
  @@index([storeId, storeDay])
  @@map("staff_check_ins")
}

// A customer's photo of their receipt (2026-10-11, testing; utils/receiptScan.ts). AI reads the store, date, total and items; the
// checks run; a receipt that passes becomes held sales (FLAGGED, one per category) for a manager or HQ to approve like any held sale.
// A refused one is kept with its reason, so the testing shows what the reader gets wrong.
model ReceiptScan {
  id             String   @id @default(uuid())
  customerId     String
  storeId        String?
  imageUrl       String?
  imageHash      String   @unique                // the same photo is never used twice
  receiptKey     String?  @unique                // store, date, receipt number and total: the same receipt photographed again
  receiptAt      DateTime?
  total          Float?
  paymentMethod  String?                         // CASH | CARD | OTHER, as read (2026-10-13)
  cardLast4      String?                         // the card's last 4 digits and brand, never more (utils/receiptCards.ts)
  cardBrand      String?
  status         String                          // HELD | REFUSED | ERROR
  reason         String?                         // why it was refused, in words the customer reads
  flags          String?                         // JSON array: what the reviewer should look at
  read           Json?                           // what the AI read
  transactionIds String[] @default([])
  createdAt      DateTime @default(now())

  customer User   @relation("ReceiptScans", fields: [customerId], references: [id], onDelete: Cascade)
  store    Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([cardLast4])
  @@map("receipt_scans")
}

// ─── Store Chat ───────────────────────────────────────────────────────────────

model ChatMessage {
  id        String   @id @default(uuid())
  storeId   String
  userId    String
  userName  String   // denormalized for display
  userRole  String   // denormalized for role badge
  text      String
  // A private message to one person in the store's thread (2026-10-23): only the sender, that person and HQ can read it. null = to everyone.
  toUserId   String?
  toUserName String?   // denormalized for display
  // A photo or a PDF in the thread (2026-10-24): kept in Cloudinary as a signed, private file; only the people who can read the message get a link.
  // attachmentId is Cloudinary's public id; attachmentKind IMAGE or PDF. text may be empty when there is an attachment.
  attachmentId    String?
  attachmentKind  String?
  attachmentName  String?
  attachmentBytes Int?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([storeId, toUserId])
  @@map("chat_messages")
}

model ChatRead {
  id         String   @id @default(uuid())
  userId     String
  storeId    String
  lastReadAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@map("chat_reads")
}

// ─── Store Requests ───────────────────────────────────────────────────────────

model StoreRequest {
  id               String               @id @default(uuid())
  storeId          String
  submittedById    String
  submitterName    String
  submitterRole    String
  type             StoreRequestType
  priority         StoreRequestPriority
  notes            String?
  status           StoreRequestStatus   @default(PENDING)
  acknowledgedById String?
  acknowledgerName String?
  acknowledgerNote String?
  acknowledgedAt   DateTime?
  createdAt        DateTime             @default(now())

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  submittedBy User  @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([submittedById])
  @@map("store_requests")
}

// ─── OTP Codes (PIN recovery) ─────────────────────────────────────────────────

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  email     String?
  code      String
  purpose   String   // "FORGOT_PIN"
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

// ─── In-App Notifications ─────────────────────────────────────────────────────

// A deal recommendation HQ dismissed (Labels > Deals): kept by its key (the item, the kind and the suggestion), so a different suggestion
// for the same item shows again. Shared by every HQ admin.
model DealRecommendationDismissal {
  key             String   @id
  labelId         String   // a plain id (no link): removing the item just leaves an unused row
  dismissedById   String
  dismissedByName String?
  dismissedAt     DateTime @default(now())

  @@index([labelId])
  @@map("deal_recommendation_dismissals")
}

// A suggested deal the owner changed before applying it (Labels > Deals, or the Add/Edit form). The next suggestions in the category learn
// from these (utils/dealSuggest.ts): the ending it was rounded to, how much it takes off, 2 for or 3 for. Never deleted; "start over"
// for a category only sets a date before which they are not used (AppConfig DEAL_LEARNING_SINCE).
model DealSuggestionEdit {
  id           String   @id @default(uuid())
  labelId      String   // a plain id (no link): removing the item keeps what was learned from it
  productName  String
  category     String?
  price        Float    // the item's price when it was changed
  suggested    String
  chosen       String
  editedById   String
  editedByName String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("deal_suggestion_edits")
}

// HQ's alerts (Notifications page) marked read, shared by every HQ admin: one row per alert id (ids are stable, e.g. "dispute-<id>").
// Before 2026-10-02 "read" lived in each browser, so another admin or another computer still showed it unread.
model AdminNotificationRead {
  notificationId String   @id
  readById       String   // a plain id (no link), so removing an admin account is not blocked by it
  readByName     String?
  readAt         DateTime @default(now())

  @@map("admin_notification_reads")
}

model UserNotification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String    // "OFFER" | "POINTS" | "REDEMPTION" | "SCHEDULE" | "SHIFT_REQUEST" | "STORE_REQUEST"
  actionUrl String?   // where tapping this notification should navigate to
  isRead    Boolean   @default(false)
  expiresAt DateTime? // when set, notification is hidden after this time (used for OFFER type)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("user_notifications")
}

// ─── Push Notifications ───────────────────────────────────────────────────────

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  appVersion String?                     // the app version that registered it (2026-10-09), for support
  lastSeenAt DateTime @default(now())     // the last time the app registered it (each sign-in and app start)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

// ─── Redemption Catalog ────────────────────────────────────────────────────────

model RedemptionCatalogItem {
  id          String   @id @default(uuid())
  chain       String   @default("Lucky Stop") // company/brand this item belongs to
  category    String   @default("IN_STORE")  // IN_STORE | GAS | HOT_FOODS
  title       String
  description String   @default("")
  emoji       String   @default("🎁")
  pointsCost  Int      // cost in points (e.g. 400 = 400 pts = $4 redeemable value)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  storeId     String?  // one store's own reward (its manager may change it); null = chain-wide, HQ only
  // The Labels catalog item this reward is (2026-10-04): its points follow that item's chain price (price x 100, rounded up to the next
  // 25: utils/rewardPoints.ts). null = points set by hand (a fountain drink, coffee: things with no label). Removing the item unlinks it.
  labelId     String?
  // false = HQ (or the store's manager) typed their own points: it stays linked (to see the item and its price) but no longer follows it
  followPrice Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store       Store?   @relation(fields: [storeId], references: [id])
  label       Label?   @relation(fields: [labelId], references: [id], onDelete: SetNull)
  redemptions CatalogRedemption[]

  @@index([storeId])
  @@index([labelId])

  @@map("redemption_catalog_items")
}

model CatalogRedemption {
  id              String    @id @default(uuid())
  customerId      String
  catalogItemId   String
  pointsSpent     Int       // points cost at time of redemption
  status          String    @default("COMPLETED") // PENDING | COMPLETED | EXPIRED | CANCELLED
  redemptionCode  String?   @unique              // 6-char code for employee to confirm
  expiresAt       DateTime?                       // 30 min from initiation for PENDING
  storeId         String?
  processedById   String?
  createdAt       DateTime  @default(now())

  customer    User                  @relation("CatalogCustomer", fields: [customerId], references: [id])
  catalogItem RedemptionCatalogItem @relation(fields: [catalogItemId], references: [id])
  store       Store?                @relation(fields: [storeId], references: [id])
  processedBy User?                 @relation("CatalogProcessor", fields: [processedById], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("catalog_redemptions")
}

// ─── Business Promotions ──────────────────────────────────────────────────────

model BusinessPromotion {
  id               String      @id @default(uuid())
  // Requester info (submitted by customer)
  requesterId      String
  requesterName    String
  requesterPhone   String
  businessName     String
  businessDescription String
  website          String?
  location         String?
  // DevAdmin publish content
  status           PromoStatus @default(PENDING)
  adTitle          String?
  adBody           String?
  adImageUrl       String?
  adExpiresAt      DateTime?
  devAdminNote     String?
  publishedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt


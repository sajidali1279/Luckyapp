// ─── Job Openings (posted by admins, visible to customers) ──────────────────

model JobOpening {
  id           String   @id @default(uuid())
  title        String
  position     String   // CASHIER | ASSISTANT_MANAGER | STORE_MANAGER | FOOD_PREP | NIGHT_SHIFT | FUEL_ATTENDANT
  storeId      String?  // null = chain-wide / any location
  description  String?
  requirements String?
  payRange     String?  // e.g. "$15–$18/hr"
  employType   String   @default("BOTH") // FULL_TIME | PART_TIME | BOTH

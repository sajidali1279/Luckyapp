// ─── Welcome / Joining Bonus Claims ──────────────────────────────────────────

model WelcomeBonusClaim {
  id            String    @id @default(uuid())
  customerId    String
  day           Int       // 1–7 (calendar day offset from account creation)
  rewardType    String    // FOUNTAIN_DRINK | COFFEE | SODA_12OZ | HOT_SNACK
  claimCode     String    @unique
  claimedAt     DateTime  @default(now())
  confirmedAt   DateTime?
  confirmedById String?
  storeId       String?

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, day])
  @@index([customerId])
  @@index([claimCode])
  @@map("welcome_bonus_claims")
}

// ─── Customer Product Requests ───────────────────────────────────────────────

model ProductRequest {
  id            String               @id @default(uuid())
  customerId    String
  storeId       String
  productName   String
  category      String?              // customer-selected category (e.g. "Groceries", "Frozen Foods")
  description   String?
  status        ProductRequestStatus @default(PENDING)
  responseNote  String?
  respondedById String?
  respondedAt   DateTime?
  expiresAt     DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  customer      User           @relation("CustomerProductRequests", fields: [customerId], references: [id], onDelete: Cascade)
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  respondedBy   User?          @relation("ProductRequestResponder", fields: [respondedById], references: [id])
  orderListItem OrderListItem?

  @@index([customerId])
  @@index([storeId])
  @@index([status])
  @@map("product_requests")
}

// ─── Tier Benefit Claims ──────────────────────────────────────────────────────

model TierBenefitClaim {
  id          String   @id @default(uuid())
  userId      String
  period      String   // "2026-H1"
  claimedAt   DateTime @default(now())
  benefitType String   // "SILVER_FOUNTAIN" | "DAILY_DRINK"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, period])
  @@map("tier_benefit_claims")
}

// ─── Order List — Procurement Ticketing System ───────────────────────────────
//
//  OrderList       = one purchase-order session per store (OPEN until closed)
//  OrderListItem   = line items inside a list
//  PrintJob        = snapshot taken when manager prints the list
//  PrintJobItem    = individual item snapshot within a print job
//  EmployeeItemRequest = employee submits a form of needed items
//  EmployeeRequestLine = individual item lines inside a request
//  OrderCategory   = tracked category strings (usage-based, DevAdmin-curated)

model OrderList {
  id          String          @id @default(uuid())
  storeId     String
  // Auto-generated readable name: "Lucky Stop 9 — May 23, 2026"
  name        String
  status      OrderListStatus @default(OPEN)
  openedById  String
  closedById  String?
  openedAt    DateTime        @default(now())
  closedAt    DateTime?
  notes       String?         // Optional note when closing (e.g. "Delivery expected Friday")

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  openedBy User           @relation("OrderListsOpened", fields: [openedById], references: [id])
  closedBy User?          @relation("OrderListsClosed", fields: [closedById], references: [id])
  items    OrderListItem[]
  printJobs PrintJob[]

  @@index([storeId, status])
  @@index([storeId, openedAt])
  @@map("order_lists")
}

model OrderListItem {
  id            String              @id @default(uuid())
  listId        String
  name          String
  quantity      String?             // "4 gallons", "2 cases", "3 boxes"
  category      String?             // Free text, curated via OrderCategory
  notes         String?
  priority      OrderItemPriority   @default(NORMAL)
  sortOrder     Int                 @default(0)
  status        OrderListItemStatus @default(PENDING)
  source           OrderItemSource     @default(MANAGER)
  requestLineId    String?             @unique  // set when accepted from employee request
  productRequestId String?             @unique  // set when accepted from customer product request
  addedById        String
  orderedAt     DateTime?
  receivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  list           OrderList            @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedBy        User                 @relation("OrderListItemsAdded", fields: [addedById], references: [id])
  requestLine    EmployeeRequestLine? @relation(fields: [requestLineId], references: [id])
  productRequest ProductRequest?      @relation(fields: [productRequestId], references: [id])
  printItems     PrintJobItem[]

  @@index([listId, status])
  @@index([listId, category])
  @@index([listId, sortOrder])
  @@map("order_list_items")
}

model PrintJob {
  id          String    @id @default(uuid())
  listId      String
  storeId     String    // denormalized for easy queries
  printedById String
  notes       String?
  itemCount   Int
  printedAt   DateTime  @default(now())

  list      OrderList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  printedBy User         @relation("PrintJobsPrinted", fields: [printedById], references: [id])
  items     PrintJobItem[]

  @@index([listId, printedAt])
  @@index([storeId, printedAt])
  @@map("print_jobs")
}

model PrintJobItem {
  id         String        @id @default(uuid())
  printJobId String
  listItemId String
  snapshot   Json          // {name, quantity, category, notes, priority} at print time

  printJob PrintJob      @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  listItem OrderListItem @relation(fields: [listItemId], references: [id])

  @@map("print_job_items")
}

model EmployeeItemRequest {
  id            String                @id @default(uuid())
  storeId       String
  submittedById String
  status        EmployeeRequestStatus @default(PENDING)
  note          String?               // Employee's optional message
  requestType   EmployeeRequestType   @default(LOW_STOCK)
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime              @default(now())

  store       Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  submittedBy User                   @relation("EmployeeRequestsSubmitted", fields: [submittedById], references: [id])
  reviewedBy  User?                  @relation("EmployeeRequestsReviewed", fields: [reviewedById], references: [id])
  lines       EmployeeRequestLine[]

  @@index([storeId, status])
  @@index([submittedById])
  @@map("employee_item_requests")
}

model EmployeeRequestLine {
  id              String           @id @default(uuid())
  requestId       String
  name            String
  quantity        String?
  category        String?
  notes           String?
  status          RequestLineStatus @default(PENDING)
  rejectionReason RejectionReason?  // predefined reason
  rejectionNote   String?           // free-text explanation
  reviewedAt      DateTime?

  request  EmployeeItemRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  listItem OrderListItem?      // populated via OrderListItem.requestLineId when accepted

  @@map("employee_request_lines")
}

model OrderCategory {
  id           String         @id @default(uuid())
  name         String
  storeId      String?        // null = global / chain-wide
  usageCount   Int            @default(1)
  status       CategoryStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())

  approvedBy User? @relation("CategoryApprovals", fields: [approvedById], references: [id])

  @@unique([name, storeId])
  @@index([status, usageCount])
  @@map("order_categories")
}

// ─── Hot Food ─────────────────────────────────────────────────────────────────

enum HotFoodOrderStatus {
  PENDING
  ACCEPTED
  READY
  COMPLETED
  CANCELLED
}

model HotFoodMenuItem {
  id               String   @id @default(uuid())
  storeId          String?  // null = available at all hot-food-enabled stores
  name             String
  description      String?
  category         String?
  price            Float
  isAvailable      Boolean  @default(true)
  estimatedMinutes Int?
  imageUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store      Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  orderItems HotFoodOrderItem[]

  @@index([storeId, isAvailable])
  @@map("hot_food_menu_items")
}

model HotFoodOrder {
  id               String             @id @default(uuid())
  orderNumber      String             @unique
  storeId          String
  customerId       String
  status           HotFoodOrderStatus @default(PENDING)
  note             String?
  estimatedMinutes Int?
  totalAmount      Float
  cancelledBy      String?            // STORE (declined), CUSTOMER (cancelled in the app) or AUTO (nobody accepted it in time)
  cancelReason     String?            // what the customer is told
  cancelledAt      DateTime?
  escalatedAt      DateTime?          // when the store's managers were told nobody had accepted it (utils/hotFoodRouting.ts), once
  paidWithPoints   Boolean            @default(false)   // the whole order paid with the customer's points (utils/hotFoodPoints.ts)
  pointsAmount     Float?                               // the credit taken when it was placed (dollars; points = x 100)
  pointsReturnedAt DateTime?                            // when the points went back (declined, cancelled, not accepted)
  readyAt          DateTime?                            // when it was marked ready (the pickup reminder counts from here)
  readyRemindedAt  DateTime?                            // when the customer was reminded it is waiting, once (utils/hotFoodAutoCancel.ts)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  store    Store              @relation(fields: [storeId], references: [id])
  customer User               @relation("HotFoodOrdersPlaced", fields: [customerId], references: [id])
  items    HotFoodOrderItem[]

  @@index([storeId, status])
  @@index([customerId])
  @@map("hot_food_orders")
}

model HotFoodOrderItem {
  id            String  @id @default(uuid())
  orderId       String
  menuItemId    String? // null when ordered from catalog item
  catalogItemId String? // set when ordered from catalog item (no FK — name/price are snapshotted)
  comboId       String? // set when ordered as a combo (no FK, the name with the drink and the price are snapshotted)
  drink         String? // the drink the customer chose for a combo (utils/hotFoodCombos.ts DRINKS)
  name          String  // snapshot at order time
  price         Float   // snapshot at order time
  quantity      Int     @default(1)

  order    HotFoodOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem HotFoodMenuItem? @relation(fields: [menuItemId], references: [id])

  @@map("hot_food_order_items")
}

// ─── Hot Food Catalog ─────────────────────────────────────────────────────────

model HotFoodCatalogItem {
  id               String   @id @default(uuid())
  name             String
  description      String?
  category         String?                     // Chicken, Wings, Sides, Family Meals... (utils/hotFoodCategories.ts); the app's menu is grouped by it
  price            Float
  imageUrl         String?
  estimatedMinutes Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stores HotFoodCatalogStore[]
  combos HotFoodCombo[]

  @@map("hot_food_catalog_items")
}

// A hot food combo (2026-10-12): one catalog item with a drink the customer chooses, for one price, set by HQ. Featured ones lead the
// app's hot food menu. Available where the store has the item on; optionally only some stores and some hours (store time).
model HotFoodCombo {
  id            String   @id @default(uuid())
  name          String
  nameEs        String?
  description   String?
  catalogItemId String
  // How many of the item come in it (2026-10-16): 2 for a "2 corn dogs for $3.50" deal. 1 = the item once, as before.
  itemQuantity  Int      @default(1)
  drinks        String[]                    // the drinks the customer may choose (utils/hotFoodCombos.ts DRINKS); none = no drink (a multi-buy deal)
  price         Float
  regularPrice  Float?                      // the item and the drink bought apart, for "Save $X" (kept within the deal limit)
  storeIds      String[] @default([])       // empty: every store that has the item on
  fromTime      String?                     // "HH:MM" store time; with toTime, only then (e.g. coffee combos 05:00 to 11:00)
  toTime        String?
  // Days of the week it is on (2026-10-16): 0 = Sunday .. 6 = Saturday, store time; empty = every day ("Corn Dog Tuesday" = [2])
  days          Int[]    @default([])
  isFeatured    Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  catalogItem HotFoodCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@map("hot_food_combos")
}

model HotFoodCatalogStore {
  id            String   @id @default(uuid())
  catalogItemId String
  storeId       String
  isAvailable   Boolean  @default(true)
  assignedAt    DateTime @default(now())

  catalogItem HotFoodCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([catalogItemId, storeId])
  @@map("hot_food_catalog_stores")
}

// ─── Admin Notices (HQ broadcast → pinned banner in store chat) ─────────────

enum NoticePriority {
  NORMAL
  URGENT // red in the app, cannot be closed, pushed as "Urgent"
}

enum NoticeAudience {
  ALL_STAFF
  MANAGERS
  EMPLOYEES
}

model AdminNotice {
  id          String   @id @default(uuid())
  title       String
  body        String
  storeId     String?  // the one store when it targets exactly one (older app builds read this); null otherwise
  storeIds    String[] @default([]) // the stores it is for; empty = every store
  audience    NoticeAudience @default(ALL_STAFF)
  priority    NoticePriority @default(NORMAL)
  createdById String
  updatedById String?
  startDate   DateTime @default(now()) // shown from here (a store day's start when scheduled ahead)
  endDate     DateTime
  isActive    Boolean  @default(true)
  notify      Boolean  @default(true) // send a push when it starts
  announcedAt DateTime? // when the push went out (once; a scheduled one goes out when it starts)
  announcedTo Int?      // how many staff it went to
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store     Store? @relation(fields: [storeId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([isActive, endDate])
  @@index([isActive, startDate])
  @@index([storeId])
  @@map("admin_notices")
}

// ─── Points Dispute ───────────────────────────────────────────────────────────

enum DisputeStatus {
  PENDING
  APPROVED
  REJECTED
}

model PointsDispute {
  id            String        @id @default(uuid())
  customerId    String
  storeId       String
  transactionId String?
  description   String
  estimatedAmt  Float?
  status        DisputeStatus @default(PENDING)
  resolvedById  String?
  resolvedNote  String?
  creditedAmt   Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer      User               @relation("DisputeSubmitter", fields: [customerId], references: [id], onDelete: Cascade)
  store         Store              @relation(fields: [storeId], references: [id])
  resolvedBy    User?              @relation("DisputeResolver", fields: [resolvedById], references: [id])
  transaction   PointsTransaction? @relation(fields: [transactionId], references: [id])

  @@index([storeId, status])
  @@index([customerId])
  @@map("points_disputes")
}


// ─── Scanned Product Catalog ──────────────────────────────────────────────────

model ScannedProduct {
  id            String   @id @default(uuid())
  barcode       String   @unique
  name          String
  category      String?
  brand         String?
  source        String   @default("manual")   // "manual" | "openfoodfacts"
  scanCount     Int      @default(1)
  lastScannedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([barcode])
  @@map("scanned_products")
}

// ─── Daily Tasks (checklists for employees per shift) ────────────────────────

model DailyTask {
  id          String    @id @default(uuid())
  shift       ShiftType
  title       String
  description String?
  storeId     String?   // null = chain-wide
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([shift, isActive])
  @@index([storeId])
  @@map("daily_tasks")
}

// ─── Daily Report ─────────────────────────────────────────────────────────────

model DailyReport {
  id            String  @id @default(uuid())
  storeId       String
  submittedById String
  reportDate    String  // YYYY-MM-DD local date

  // Prices
  gasPrice      Float?
  dieselPrice   Float?

  // Inventory
  regGasGal      Float?
  midGradeGasGal Float?
  premiumGasGal  Float?
  cigsCount      Int?

  // Extras
  imageUrl  String?
  notes     String?

  createdAt DateTime @default(now())

  store       Store @relation(fields: [storeId], references: [id])
  submittedBy User  @relation("DailyReportsSubmitted", fields: [submittedById], references: [id])

  @@index([storeId, reportDate])
  @@map("daily_reports")
}

// ─── Refer a friend (2026-10-09) ─────────────────────────────────────────────
// A customer shares their code; a new customer enters it when signing up (or soon after). When the friend's first approved
// purchase of at least the minimum is made within the window, both are paid (utils/referrals.ts), the sharer at most the
// monthly limit. Amounts and limits: AppConfig REFERRAL_SETTINGS.
model Referral {
  id               String    @id @default(uuid())
  referrerId       String
  friendId         String    @unique
  code             String
  status           String    @default("PENDING")   // PENDING | REWARDED | EXPIRED | CANCELLED
  referrerRewarded Boolean   @default(false)       // false on a REWARDED one: the sharer was over the monthly limit
  referrerReward   Float?
  friendReward     Float?
  saleId           String?                         // the friend's qualifying purchase
  storeId          String?
  note             String?
  createdAt        DateTime  @default(now())
  rewardedAt       DateTime?

  referrer User @relation("Referrer", fields: [referrerId], references: [id])
  friend   User @relation("ReferredFriend", fields: [friendId], references: [id])

  @@index([referrerId, status])
  @@index([createdAt])
  @@map("referrals")
}

// ─── Support notes on a customer (2026-10-09) ────────────────────────────────
// HQ's private notes ("called about missing points"). Never shown to the customer; removed when the account is deleted.
model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  authorId   String
  authorName String?
  text       String
  createdAt  DateTime @default(now())

  customer User @relation("NoteCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

// ─── Points expiry (2026-10-17) ──────────────────────────────────────────────
// Every credit to a customer's balance is a batch (lot) with its own date; spending takes the oldest batches first (first in, first
// out), so points expire in the order they were earned. A batch expires HQ's days after its date, or after the day HQ switched expiry
// on if that is later (Settings > Rewards & offers > Points expiry, utils/appSettings.ts pointsExpiry()). utils/pointLots.ts keeps them.
// Amounts are dollars of credit, like users.pointsBalance (100 points = $1). The balance is the sum of what is left in the batches; a
// balance below zero (a voided sale the customer had already spent) has no batches left and is paid back by the next credit.
model PointLot {
  id            String    @id @default(uuid())
  userId        String
  amount        Float               // what was credited
  remaining     Float               // what is left of it
  earnedAt      DateTime  @default(now())
  source        String              // SALE, RECEIPT_QR, CHALLENGE, REFERRAL, WINBACK, GOODWILL, DISPUTE, RESTORED, OPENING, TEST
  sourceId      String?             // the sale, redemption or order it came from
  expiredAmount Float     @default(0)
  expiredAt     DateTime?
  expiryUndoneAt DateTime?          // HQ gave the expired points back (they became a new RESTORED batch)
  removedAmount Float     @default(0)  // taken back when its sale was voided
  warnedAt      DateTime?           // the "expiring soon" push for it was sent
  createdAt     DateTime  @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  uses PointLotUse[]

  @@index([userId, earnedAt])
  @@index([remaining, earnedAt])
  @@index([sourceId])
  @@map("point_lots")
}

// Which batches a spend took, so a refund (an unused reward code, a cancelled hot food order) puts the points back where they came from
model PointLotUse {
  id         String    @id @default(uuid())
  lotId      String
  userId     String
  amount     Float
  refType    String              // CREDIT_REDEMPTION, CATALOG, HOT_FOOD, VOID
  refId      String?
  restoredAt DateTime?
  createdAt  DateTime  @default(now())

  lot  PointLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, refType, refId])
  @@index([lotId])
  @@map("point_lot_uses")
}

// ─── Missing person posters (2026-10-18) ─────────────────────────────────────
// HQ posts them from an official source only (a police case number, an AMBER Alert): customers see an active poster on Home near
// their store, can call the agency or 911, and may get one push when HQ sends it. Tips go to the police, never to the app. A poster stays
// up until HQ marks it found or resolved, and every 30 days HQ must confirm it is still active (reviewDueAt) or it stops showing.
// When it ends, the photo is deleted and the personal details are cleared; the case number, agency and dates stay for the record.
model MissingPerson {
  id               String    @id @default(uuid())
  name             String
  age              Int?
  photoUrl         String?
  photoPublicId    String?             // Cloudinary id, to delete the photo when the poster ends
  lastSeenAt       DateTime
  lastSeenPlace    String
  description      String?             // height, hair, clothing, vehicle...
  descriptionEs    String?
  agencyName       String              // e.g. "Harris County Sheriff's Office"
  agencyPhone      String              // the number customers call with information
  caseNumber       String
  sourceUrl        String?             // the official alert or agency page
  urgent           Boolean   @default(false)   // an AMBER Alert or an endangered person: shown first, in red
  storeIds         String[]  @default([])      // the stores whose customers see it; empty = every store
  status           String    @default("ACTIVE") // ACTIVE, FOUND, RESOLVED, REMOVED
  reviewDueAt      DateTime            // HQ confirms it is still active by then, or it stops showing
  reviewNotifiedAt DateTime?
  pushSentAt       DateTime?
  pushCount        Int       @default(0)
  endedAt          DateTime?
  endNote          String?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, reviewDueAt])
  @@map("missing_persons")
}

// A customer asks HQ to post a missing person (2026-10-18). Only with a police case number: HQ checks it with the agency, then posts it
// (the poster is made from the request, photo and all) or declines it, and the requester is told either way. When HQ decides, or after
// 30 days with no decision, the person's details and the photo are cleared; the cleared record goes 30 days later.
model MissingPersonRequest {
  id             String    @id @default(uuid())
  requesterId    String
  requesterPhone String              // who HQ calls back; only HQ sees it
  relationship   String              // FAMILY, FRIEND, OTHER
  storeId        String?             // the requester's store, so HQ knows where to show it
  name           String
  age            Int?
  photoUrl       String?
  photoPublicId  String?
  lastSeenAt     DateTime
  lastSeenPlace  String
  description    String?
  agencyName     String
  agencyPhone    String?             // the requester may not know it; HQ finds it when checking
  caseNumber     String
  status         String    @default("PENDING") // PENDING, APPROVED, DECLINED, EXPIRED
  declineReason  String?
  posterId       String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([requesterId, createdAt])
  @@map("missing_person_requests")
}

// ─── Engagement (2026-10-23, admin Engagement page) ──────────────────────────
// One row each time something engagement-related happens to a customer that must never happen twice: a streak milestone paid, a daily
// check-in, a store goal paid, a nudge sent. The unique (customer, kind, key) is what makes each of them once-only, even when two
// requests race (inserted with skipDuplicates). `points` is the dollars paid, when it paid anything.
model EngagementEvent {
  id         String   @id @default(uuid())
  customerId String
  kind       String   // STREAK_AWARD | CHECKIN | GOAL_AWARD | NUDGE_NEAR_REWARD | NUDGE_STREAK_RISK | NUDGE_TIER_RESET | NUDGE_COMEBACK | GAS_ALERT
  key        String   // what makes it "the same one again": a streak and its milestone, a store day, a goal, a week
  points     Float    @default(0)
  createdAt  DateTime @default(now())

  @@unique([customerId, kind, key])
  @@index([kind, createdAt])
  @@index([customerId, createdAt])
  @@map("engagement_events")
}

// A store goal: "if Katy makes 200 sales this week, everyone who bought there gets 50 pts". Counted per store, paid once when the window
// has ended and the target was reached (utils/engagement-cron.ts), to each customer with at least one approved purchase at that store.
model StoreGoal {
  id           String    @id @default(uuid())
  storeId      String?   // null = every store, each one counted on its own
  title        String
  titleEs      String?
  metric       String    // SALES (approved purchases) | CUSTOMERS (different customers who bought)
  target       Int
  rewardPoints Int       // points each qualifying customer gets (100 pts = $1)
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean   @default(true)
  paidAt       DateTime? // when the reward was paid out
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, endDate])
  @@map("store_goals")
}

// "Tell me when regular drops below $2.89 at my store" (one per customer, store and fuel).
model GasAlert {
  id         String    @id @default(uuid())
  customerId String
  storeId    String
  fuel       String    // GAS | DIESEL
  maxPrice   Float
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([customerId, storeId, fuel])
  @@index([storeId, fuel])
  @@map("gas_alerts")
}

// Flash deals (2026-10-24, admin > Engagement): a short, time-boxed message from HQ ("Double points on hot food until 2 PM") that is pushed
// once to an audience and shows on the customer's Home with a countdown until it ends. announcedAt is the claim that makes the push go
// out once; sentCount is how many people it reached. Cancelled before it started: cancelledAt. Ended early: endsAt moved to that moment.
model FlashDeal {
  id          String    @id @default(uuid())
  title       String
  titleEs     String?
  body        String
  bodyEs      String?
  link        String    @default("NONE")   // NONE | OFFERS | HOT_FOOD | REWARDS | GAS
  audience    String    @default("ALL")    // ALL | STORE | TIER
  storeId     String?
  tier        Tier?
  startsAt    DateTime
  endsAt      DateTime
  announcedAt DateTime?
  sentCount   Int       @default(0)
  cancelledAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([startsAt, endsAt])
  @@map("flash_deals")
}

// ─── Invoices to PDI ─────────────────────────────────────────────────────────

// A vendor's paper invoice turned into the file PDI imports (2026-10-27, utils/pdiInvoice.ts and utils/pdiRead.ts): the photos, what the
// AI read, a person's corrections, the file. `paper` holds the lines as read and then corrected; the problems are worked out from it each
// time it is opened, so a fix or a confirmed units-per-case shows at once.
model PdiInvoice {
  id             String    @id @default(uuid())
  storeId        String
  vendorId       String?                         // whose invoice it is (null until the vendor read off it is matched or chosen)
  vendorRead     String?                         // the vendor's name as read off the invoice
  status         String                          // READING | READ | FAILED | DONE (the file was downloaded)
  photoIds       String[]  @default([])          // Cloudinary ids (private), in the order they were added
  invoiceNumber  String?                         // as read, digits: the duplicate warning matches on vendor and this
  invoiceDate    String?                         // YYYY-MM-DD, as read
  totalCents     Int?
  paper          Json?                           // the PaperInvoice: what was read, then corrected
  checked        String[]  @default([])          // problems a person looked at and accepted: "line|field|message"
  readModel      String?
  readUsage      Json?                           // input and output tokens of the last reading, for its cost
  readError      String?
  readStartedAt  DateTime?
  createdById    String
  updatedById    String?
  downloadedAt   DateTime?
  downloadedById String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store  Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vendor PdiVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([vendorId, invoiceNumber])
  @@map("pdi_invoices")
}

// Units per case each product comes in, by vendor (Ed F. Davis prints none on its invoices): learned from an old Deep Water file, or
// confirmed by a person on the review page (a confirmed one is never overwritten by a learned one). Keyed by the full 12-digit UPC.
model PdiProductUnits {
  vendorId     String
  upc          String                            // 12 digits (pdiInvoice.ts fullUpc)
  unitsPerCase Int
  source       String                            // LEARNED | CONFIRMED
  description  String?
  updatedById  String?
  updatedAt    DateTime  @updatedAt

  vendor PdiVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([vendorId, upc])
  @@map("pdi_product_units")
}

// A vendor whose invoices are read for PDI (2026-10-28): the vendor is read off the invoice and matched by its names (utils/pdiVendors.ts),
// so there is no vendor list to pick from. What the file needs to know about it is set once, by a person or from its Deep Water files.
model PdiVendor {
  id          String   @id @default(uuid())
  name        String                       // as people know it ("Frito-Lay")
  pdiCode     String?  @unique             // its code in PDI ("FRITO"), up to 6 letters or digits; null until someone sets it
  aliases     String[] @default([])        // names it was printed as, compared as pdiVendors.ts vendorKey writes them
  sellsBy     String   @default("CASE")    // CASE | EACH: what its quantities count
  itemDigits  String   @default("FIRST6")  // its item numbers in the file's 6 places: FIRST6 | LAST6 | NONE (it prints none)
  itemLength  Int?                         // how many digits its item numbers have, to catch a misread (Frito-Lay 8)
  readerNotes String?                      // how its invoices are laid out, for the reader (pdiRead.ts)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices PdiInvoice[]
  units    PdiProductUnits[]

  @@map("pdi_vendors")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum StoreRequestType {
  LOW_STOCK
  STORE_SUPPLIES
  CUSTOMER_REQUESTED_PRODUCT
  WORK_ORDER
}

enum StoreRequestPriority {
  LOW
  MEDIUM
  HIGH
}

enum StoreRequestStatus {
  PENDING
  ACKNOWLEDGED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum ShiftType {
  OPENING
  MIDDLE
  CLOSING
}

enum ShiftRequestType {
  TIME_OFF
  FILL_IN
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum Role {
  DEV_ADMIN    // Developer (you) — full access + billing
  SUPER_ADMIN  // LuckyStop HQ — all stores, offers, banners
  STORE_MANAGER // Per-store management
  EMPLOYEE     // Scan QR, upload receipt, grant points
  CUSTOMER     // Mobile app user
}

enum BillingType {
  MONTHLY_SUBSCRIPTION
  PER_TRANSACTION
  HYBRID
  CUSTOM
}

enum TransactionStatus {
  PENDING    // Waiting for receipt upload
  FLAGGED    // Suspicious — receipt uploaded but points held for manager review
  APPROVED   // Points granted
  REJECTED   // Rejected by admin/auto
}

enum OfferType {
  ALL_STORES   // Applies to all 14 stores
  SPECIFIC_STORE
}

enum ProductCategory {
  GROCERIES
  FROZEN_FOODS
  FRESH_FOODS
  GAS
  DIESEL
  HOT_FOODS
  OTHER
}

enum ApplicationStatus {
  NEW
  REVIEWED
  INTERVIEW
  HIRED
  REJECTED
}

enum ProductRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum OrderItemPriority {
  URGENT
  NORMAL
  LOW
}

enum OrderListStatus {
  OPEN    // Active — manager is building this list
  CLOSED  // Order placed / delivered
}

enum OrderListItemStatus {
  PENDING   // On the list, not yet ordered
  ORDERED   // Manager confirmed ordered from supplier
  RECEIVED  // Arrived at store
  REMOVED   // Removed from list (soft delete)
}

enum OrderItemSource {
  MANAGER           // Added directly by manager
  EMPLOYEE_REQUEST  // Accepted from an employee request
}

enum EmployeeRequestStatus {
  PENDING   // Not yet reviewed by manager
  REVIEWED  // Manager has processed all lines
}

enum RequestLineStatus {
  PENDING   // Not yet reviewed
  ACCEPTED  // Added to active order list
  REJECTED  // Rejected with reason
}

enum RejectionReason {
  NO_SUPPLIER   // No supplier available
  OUT_OF_BUDGET // Out of budget
  IN_STOCK      // Already in stock
  DUPLICATE     // Already on the list
  OTHER         // See rejectionNote
}

enum CategoryStatus {
  PENDING   // Awaiting DevAdmin review
  APPROVED  // Shown in category dropdowns
  REJECTED  // Hidden / removed
}

enum EmployeeRequestType {
  LOW_STOCK         // Running low on an item
  CUSTOMER_REQUEST  // Customer asked for this product
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  DIAMOND
  PLATINUM
}

enum PromoStatus {
  PENDING    // Customer submitted, awaiting DevAdmin review
  APPROVED   // DevAdmin published — visible to all customers
  REJECTED   // DevAdmin rejected
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  phone           String   @unique
  name            String?
  role            Role     @default(CUSTOMER)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Auth — phone + PIN
  pinHash         String?
  pinHistory      String[] // last 3 PIN hashes (prevent reuse)
  isProfileComplete Boolean @default(false)

  // Tier system
  tier            Tier     @default(BRONZE)
  periodPoints    Float    @default(0)   // points earned this period (in dollars, × 100 = pts for display)
  tierPeriod      String   @default("2026-H1")  // "YYYY-H1" or "YYYY-H2"

  // Account recovery
  email           String?  @unique
  emailVerified   Boolean  @default(false)

  // Login rate limiting
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Customer-specific
  qrCode          String?  @unique
  pointsBalance   Float    @default(0)
  avatarUrl       String?
  age21Confirmed  Boolean  @default(false)

  // Multi-store manager flag — when true, STORE_MANAGER bypasses per-store access check
  allStoresAccess      Boolean  @default(false)

  // Fraud / restriction
  fraudNote            String?  // reason stored when account is restricted for fraud

  // Relations
  storeRoles           UserStoreRole[]
  disputes             PointsDispute[]  @relation("DisputeSubmitter")
  resolvedDisputes     PointsDispute[]  @relation("DisputeResolver")
  pointsEarned         PointsTransaction[]  @relation("PointsEarner")
  pointsGranted        PointsTransaction[]  @relation("PointsGranter")
  redemptions          Redemption[]
  creditRedemptions    CreditRedemption[]   @relation("CustomerRedemptions")
  processedRedemptions CreditRedemption[]   @relation("ProcessorRedemptions")
  pushTokens           PushToken[]
  notifications        UserNotification[]
  tierBenefitClaims         TierBenefitClaim[]
  welcomeBonusClaims        WelcomeBonusClaim[]
  catalogRedemptions        CatalogRedemption[]  @relation("CatalogCustomer")
  processedCatalogRedemptions CatalogRedemption[] @relation("CatalogProcessor")
  shiftTemplates       ShiftTemplate[]      @relation("EmployeeShifts")
  shiftRequests        ShiftRequest[]       @relation("EmployeeRequests")
  chatMessages         ChatMessage[]
  submittedStoreRequests StoreRequest[]
  productRequests        ProductRequest[] @relation("CustomerProductRequests")
  respondedProductRequests ProductRequest[] @relation("ProductRequestResponder")
  businessPromotions     BusinessPromotion[]
  supportThreads       SupportThread[]
  supportMessages      SupportMessage[]
  ratingsGiven         EmployeeRating[] @relation("RatingsGiven")
  ratingsReceived      EmployeeRating[] @relation("RatingsReceived")
  // Order list system
  openedOrderLists     OrderList[]      @relation("OrderListsOpened")
  closedOrderLists     OrderList[]      @relation("OrderListsClosed")
  addedOrderListItems  OrderListItem[]  @relation("OrderListItemsAdded")
  managedPrintJobs     PrintJob[]       @relation("PrintJobsPrinted")
  approvedCategories   OrderCategory[]  @relation("CategoryApprovals")
  submittedItemRequests EmployeeItemRequest[] @relation("EmployeeRequestsSubmitted")
  reviewedItemRequests  EmployeeItemRequest[] @relation("EmployeeRequestsReviewed")

  @@map("users")
}

model Store {
  id          String   @id @default(uuid())
  name        String
  address     String
  city        String
  state       String
  zipCode     String
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Billing (managed by DevAdmin only)
  billingType       BillingType @default(MONTHLY_SUBSCRIPTION)
  subscriptionPrice Float       @default(99.00)
  transactionFeeRate Float      @default(0.02)

  // Scheduling
  shiftsPerDay      Int         @default(3)  // 2 or 3 shifts per day

  // Location (for customer proximity detection)
  latitude          Float?
  longitude         Float?

  // Age-restricted store gate (21 = requires 21+ confirmation before showing content)
  minimumAge        Int?

  // Gas prices (updated daily by admins)
  gasPricePerGallon    Float?
  dieselPricePerGallon Float?
  gasPriceUpdatedAt    DateTime?

  // Per-store category availability (empty = all categories enabled)
  enabledCategories ProductCategory[]

  // Printer agent authentication
  apiKey            String?     @unique

  // Relations
  userRoles         UserStoreRole[]
  transactions      PointsTransaction[]
  creditRedemptions CreditRedemption[]
  offers            Offer[]
  banners           Banner[]
  billing           BillingRecord[]
  receiptTokens     ReceiptToken[]
  shiftTemplates    ShiftTemplate[]
  shiftRequests     ShiftRequest[]
  chatMessages      ChatMessage[]
  storeRequests     StoreRequest[]
  catalogRedemptions CatalogRedemption[]
  employeeRatings    EmployeeRating[]
  keywordMappings    StoreKeywordMapping[]
  jobApplications    JobApplication[]
  productRequests    ProductRequest[]
  orderLists         OrderList[]
  printJobs          PrintJob[]
  employeeItemRequests EmployeeItemRequest[]
  pointsDisputes       PointsDispute[]

  @@map("stores")
}

// Per-store POS keyword → Lucky Stop category mappings
// Printer-agent fetches these so store-specific labels are classified correctly
model StoreKeywordMapping {
  id        String          @id @default(uuid())
  storeId   String
  keyword   String
  category  ProductCategory
  createdAt DateTime        @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, keyword])
  @@map("store_keyword_mappings")
}

// Links employees/managers to their specific stores
model UserStoreRole {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  role      Role
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@map("user_store_roles")
}

// ─── Points System ────────────────────────────────────────────────────────────

model PointsTransaction {
  id              String            @id @default(uuid())
  customerId      String
  grantedById     String
  storeId         String
  purchaseAmount  Float
  pointsAwarded   Float             // cashback credited to customer
  devCut          Float             // dev's cut of cashback issued (taken at grant time)
  storeCost       Float             // full cashback issued — store bears this cost
  cashbackRate    Float             @default(0.05) // rate used at time of grant
  category        ProductCategory   @default(OTHER)
  status          TransactionStatus @default(PENDING)
  receiptImageUrl  String?
  receiptImageHash String? @unique   // SHA-256 of receipt file — reuse of same photo across any transaction is blocked
  notes            String?
  isGas             Boolean @default(false)
  gasGallons        Float?
  gasPricePerGallon Float?
  gasBonusPoints    Float   @default(0)
  fraudFlags        String?           // JSON array of fraud flag reasons
  isTestData        Boolean @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customer    User  @relation("PointsEarner", fields: [customerId], references: [id])
  grantedBy   User  @relation("PointsGranter", fields: [grantedById], references: [id])
  store       Store @relation(fields: [storeId], references: [id])
  rating      EmployeeRating?

  @@index([customerId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
  @@index([storeId, status, createdAt])
  @@map("points_transactions")
}

// ─── Tier Cashback Rates (DevAdmin configurable) ─────────────────────────────
// Primary rate driver: customer's tier determines base cashback %
// Bronze=1%, Silver=2%, Gold=3%, Diamond=4%, Platinum=5% (all configurable)

model TierCashbackRate {
  tier              Tier     @id
  cashbackRate      Float    // percentage cashback for all categories (e.g. 0.01 = 1%)
  gasCentsPerGallon Float?   // if set: flat ¢/gallon for GAS/DIESEL instead of percentage (e.g. 3.0 = 3¢/gal)
  pointsThreshold   Float?   // minimum period earnings in dollars to reach this tier (null = use hardcoded default)
  updatedAt         DateTime @updatedAt

  @@map("tier_cashback_rates")
}

// ─── Category Cashback Rates (additive bonus on top of tier base rate per category) ─

model CategoryRate {
  category     ProductCategory @id
  cashbackRate Float           @default(0.05)
  updatedAt    DateTime        @updatedAt

  @@map("category_rates")
}

// Tracks when a customer uses their credit balance in-store
model CreditRedemption {
  id          String   @id @default(uuid())
  customerId  String
  storeId     String
  amount      Float                       // Credits redeemed
  devCut      Float    @default(0)        // Platform fee (% of redeemed amount)
  processedBy String
  createdAt   DateTime @default(now())

  customer  User  @relation("CustomerRedemptions", fields: [customerId], references: [id])
  store     Store @relation(fields: [storeId], references: [id])
  processor User  @relation("ProcessorRedemptions", fields: [processedBy], references: [id])

  @@index([customerId])
  @@index([createdAt])
  @@map("credit_redemptions")
}

// ─── Offers & Promotions ──────────────────────────────────────────────────────

model Offer {
  id          String      @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  type        OfferType   @default(ALL_STORES)
  storeId     String?
  category    ProductCategory?
  bonusRate              Float?  // bonus for ALL tiers equally — OR max value when tierBonusRates is set (used for ordering)
  tierBonusRates         Json?   // per-tier bonus override: {"BRONZE": 0.03, "GOLD": 0.01, ...} — wins over bonusRate per tier
  gasBonusCentsPerGallon Float?  // ¢/gallon bonus for GAS/DIESEL offers (used instead of bonusRate when in per-gallon mode)
  dealText               String? // price deal label e.g. "2 for $5" (display only)
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  store Store? @relation(fields: [storeId], references: [id])

  @@index([isActive, startDate, endDate])
  @@index([storeId])
  @@map("offers")
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  storeId   String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store Store? @relation(fields: [storeId], references: [id])

  @@index([isActive, storeId])
  @@map("banners")
}

// ─── Rewards (future catalog) ─────────────────────────────────────────────────

model Reward {
  id            String   @id @default(uuid())
  name          String
  description   String
  imageUrl      String?
  pointsCost    Float
  isActive      Boolean  @default(true)
  stockLimit    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  redemptions Redemption[]

  @@map("rewards")
}

model Redemption {
  id          String   @id @default(uuid())
  customerId  String
  rewardId    String
  pointsSpent Float
  redeemedAt  DateTime @default(now())
  verifiedAt  DateTime?
  verifiedBy  String?

  customer User   @relation(fields: [customerId], references: [id])
  reward   Reward @relation(fields: [rewardId], references: [id])

  @@index([customerId])
  @@index([redeemedAt])
  @@map("redemptions")
}

// ─── Billing (DevAdmin only) ──────────────────────────────────────────────────

model BillingRecord {
  id          String   @id @default(uuid())
  storeId     String
  billingType BillingType
  amount      Float
  period      String
  notes       String?  // JSON: full compound breakdown (rates, categories, fee split)
  isPaid      Boolean  @default(false)
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@map("billing_records")
}

// ─── Receipt QR Tokens (printer agent → customer self-grant) ─────────────────

model ReceiptToken {
  id        String    @id @default(uuid())
  storeId   String
  txRef     String    // POS transaction reference — prevents duplicate QR generation
  total     Float
  items     String    // JSON: [{category: ProductCategory, amount: number}]
  usedBy    String?   // customer userId who claimed it
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, txRef])
  @@index([expiresAt])
  @@map("receipt_tokens")
}

// ─── Platform Config (DevAdmin key-value store) ───────────────────────────────

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

// ─── Audit Log (DevAdmin fraud monitoring) ───────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorName  String?
  actorRole  String
  action     String   // CREATE_OFFER, DELETE_OFFER, CREATE_BANNER, DELETE_BANNER, GRANT_POINTS, REJECT_TRANSACTION, REDEEM_CREDITS, CREATE_STAFF, TOGGLE_USER, RESET_PIN, SELF_GRANT
  entity     String   // offer, banner, transaction, staff, user
  entityId   String?
  details    String?  // JSON: context fields (amounts, names, etc.)
  storeId    String?
  storeName  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([storeId])
  @@index([action])
  @@map("audit_logs")
}

// ─── Scheduling ───────────────────────────────────────────────────────────────

model ShiftTemplate {
  id         String    @id @default(uuid())
  employeeId String
  storeId    String
  dayOfWeek  DayOfWeek
  shiftType  ShiftType
  startTime  String    // "06:00", "10:00", or "14:00"
  endTime    String    // "14:00", "18:00", or "22:00"
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee User  @relation("EmployeeShifts", fields: [employeeId], references: [id], onDelete: Cascade)
  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, storeId, dayOfWeek])
  @@index([storeId])
  @@index([employeeId])
  @@map("shift_templates")
}

model ShiftRequest {
  id          String           @id @default(uuid())
  employeeId  String
  storeId     String
  requestType ShiftRequestType
  date        DateTime
  shiftType   ShiftType
  status      RequestStatus    @default(PENDING)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  employee User  @relation("EmployeeRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
  @@index([employeeId])
  @@map("shift_requests")
}

// ─── Store Chat ───────────────────────────────────────────────────────────────

model ChatMessage {
  id        String   @id @default(uuid())
  storeId   String
  userId    String
  userName  String   // denormalized for display
  userRole  String   // denormalized for role badge
  text      String
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("chat_messages")
}

// ─── Store Requests ───────────────────────────────────────────────────────────

model StoreRequest {
  id               String               @id @default(uuid())
  storeId          String
  submittedById    String
  submitterName    String
  submitterRole    String
  type             StoreRequestType
  priority         StoreRequestPriority
  notes            String?
  status           StoreRequestStatus   @default(PENDING)
  acknowledgedById String?
  acknowledgerName String?
  acknowledgerNote String?
  acknowledgedAt   DateTime?
  createdAt        DateTime             @default(now())

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  submittedBy User  @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([submittedById])
  @@map("store_requests")
}

// ─── OTP Codes (PIN recovery) ─────────────────────────────────────────────────

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  email     String?
  code      String
  purpose   String   // "FORGOT_PIN"
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

// ─── In-App Notifications ─────────────────────────────────────────────────────

model UserNotification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String    // "OFFER" | "POINTS" | "REDEMPTION" | "SCHEDULE" | "SHIFT_REQUEST" | "STORE_REQUEST"
  isRead    Boolean   @default(false)
  expiresAt DateTime? // when set, notification is hidden after this time (used for OFFER type)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("user_notifications")
}

// ─── Push Notifications ───────────────────────────────────────────────────────

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

// ─── Redemption Catalog ────────────────────────────────────────────────────────

model RedemptionCatalogItem {
  id          String   @id @default(uuid())
  chain       String   @default("Lucky Stop") // company/brand this item belongs to
  category    String   @default("IN_STORE")  // IN_STORE | GAS | HOT_FOODS
  title       String
  description String   @default("")
  emoji       String   @default("🎁")
  pointsCost  Int      // cost in points (e.g. 400 = 400 pts = $4 redeemable value)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions CatalogRedemption[]

  @@map("redemption_catalog_items")
}

model CatalogRedemption {
  id              String    @id @default(uuid())
  customerId      String
  catalogItemId   String
  pointsSpent     Int       // points cost at time of redemption
  status          String    @default("COMPLETED") // PENDING | COMPLETED | EXPIRED | CANCELLED
  redemptionCode  String?   @unique              // 6-char code for employee to confirm
  expiresAt       DateTime?                       // 30 min from initiation for PENDING
  storeId         String?
  processedById   String?
  createdAt       DateTime  @default(now())

  customer    User                  @relation("CatalogCustomer", fields: [customerId], references: [id])
  catalogItem RedemptionCatalogItem @relation(fields: [catalogItemId], references: [id])
  store       Store?                @relation(fields: [storeId], references: [id])
  processedBy User?                 @relation("CatalogProcessor", fields: [processedById], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("catalog_redemptions")
}

// ─── Business Promotions ──────────────────────────────────────────────────────

model BusinessPromotion {
  id               String      @id @default(uuid())
  // Requester info (submitted by customer)
  requesterId      String
  requesterName    String
  requesterPhone   String
  businessName     String
  businessDescription String
  website          String?
  // DevAdmin publish content
  status           PromoStatus @default(PENDING)
  adTitle          String?
  adBody           String?
  adImageUrl       String?
  adExpiresAt      DateTime?
  devAdminNote     String?
  publishedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  requester User @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([requesterId])
  @@map("business_promotions")
}

// ─── Support Threads (SuperAdmin → DevAdmin) ─────────────────────────────────

model SupportThread {
  id         String   @id @default(uuid())
  fromUserId String
  fromName   String
  subject    String
  status     String   @default("OPEN")  // OPEN | RESOLVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages SupportMessage[]
  fromUser User             @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([status])
  @@map("support_threads")
}

model SupportMessage {
  id         String   @id @default(uuid())
  threadId   String
  senderId   String
  senderName String
  senderRole String
  body       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("support_messages")
}

// ─── Employee Ratings ─────────────────────────────────────────────────────────

model EmployeeRating {
  id            String   @id @default(uuid())
  transactionId String   @unique
  customerId    String
  employeeId    String
  storeId       String
  rating        Int      // 1–5
  createdAt     DateTime @default(now())

  transaction PointsTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customer    User  @relation("RatingsGiven",    fields: [customerId],  references: [id])
  employee    User  @relation("RatingsReceived", fields: [employeeId],  references: [id])
  store       Store @relation(fields: [storeId], references: [id])

  @@index([employeeId, storeId])
  @@index([customerId])
  @@index([createdAt])
  @@map("employee_ratings")
}

// ─── Job Applications ─────────────────────────────────────────────────────────

model JobApplication {
  id           String            @id @default(uuid())
  name         String
  phone        String
  email        String?
  position     String            // CASHIER | ASSISTANT_MANAGER | STORE_MANAGER | FOOD_PREP | NIGHT_SHIFT | FUEL_ATTENDANT
  storeId      String?
  availability Json              // { type: "FULL_TIME"|"PART_TIME", shifts: string[] }
  experience   String?
  message      String?
  status       ApplicationStatus @default(NEW)
  reviewNotes  String?
  customerId   String?           // logged-in customer who submitted
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  store Store? @relation(fields: [storeId], references: [id])

  @@index([status])
  @@index([phone])
  @@index([createdAt])
  @@map("job_applications")
}

// ─── Welcome / Joining Bonus Claims ──────────────────────────────────────────

model WelcomeBonusClaim {
  id            String    @id @default(uuid())
  customerId    String
  day           Int       // 1–7 (calendar day offset from account creation)
  rewardType    String    // FOUNTAIN_DRINK | COFFEE | SODA_12OZ | HOT_SNACK
  claimCode     String    @unique
  claimedAt     DateTime  @default(now())
  confirmedAt   DateTime?
  confirmedById String?
  storeId       String?

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, day])
  @@index([customerId])
  @@index([claimCode])
  @@map("welcome_bonus_claims")
}

// ─── Customer Product Requests ───────────────────────────────────────────────

model ProductRequest {
  id            String               @id @default(uuid())
  customerId    String
  storeId       String
  productName   String
  description   String?
  status        ProductRequestStatus @default(PENDING)
  responseNote  String?
  respondedById String?
  respondedAt   DateTime?
  expiresAt     DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  customer    User  @relation("CustomerProductRequests", fields: [customerId], references: [id], onDelete: Cascade)
  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  respondedBy User? @relation("ProductRequestResponder", fields: [respondedById], references: [id])

  @@index([customerId])
  @@index([storeId])
  @@index([status])
  @@map("product_requests")
}

// ─── Tier Benefit Claims ──────────────────────────────────────────────────────

model TierBenefitClaim {
  id          String   @id @default(uuid())
  userId      String
  period      String   // "2026-H1"
  claimedAt   DateTime @default(now())
  benefitType String   // "SILVER_FOUNTAIN" | "DAILY_DRINK"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, period])
  @@map("tier_benefit_claims")
}

// ─── Order List — Procurement Ticketing System ───────────────────────────────
//
//  OrderList       = one purchase-order session per store (OPEN until closed)
//  OrderListItem   = line items inside a list
//  PrintJob        = snapshot taken when manager prints the list
//  PrintJobItem    = individual item snapshot within a print job
//  EmployeeItemRequest = employee submits a form of needed items
//  EmployeeRequestLine = individual item lines inside a request
//  OrderCategory   = tracked category strings (usage-based, DevAdmin-curated)

model OrderList {
  id          String          @id @default(uuid())
  storeId     String
  // Auto-generated readable name: "Lucky Stop 9 — May 23, 2026"
  name        String
  status      OrderListStatus @default(OPEN)
  openedById  String
  closedById  String?
  openedAt    DateTime        @default(now())
  closedAt    DateTime?
  notes       String?         // Optional note when closing (e.g. "Delivery expected Friday")

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  openedBy User           @relation("OrderListsOpened", fields: [openedById], references: [id])
  closedBy User?          @relation("OrderListsClosed", fields: [closedById], references: [id])
  items    OrderListItem[]
  printJobs PrintJob[]

  @@index([storeId, status])
  @@index([storeId, openedAt])
  @@map("order_lists")
}

model OrderListItem {
  id            String              @id @default(uuid())
  listId        String
  name          String
  quantity      String?             // "4 gallons", "2 cases", "3 boxes"
  category      String?             // Free text, curated via OrderCategory
  notes         String?
  priority      OrderItemPriority   @default(NORMAL)
  sortOrder     Int                 @default(0)
  status        OrderListItemStatus @default(PENDING)
  source        OrderItemSource     @default(MANAGER)
  requestLineId String?             @unique  // set when accepted from employee request
  addedById     String
  orderedAt     DateTime?
  receivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  list        OrderList            @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedBy     User                 @relation("OrderListItemsAdded", fields: [addedById], references: [id])
  requestLine EmployeeRequestLine? @relation(fields: [requestLineId], references: [id])
  printItems  PrintJobItem[]

  @@index([listId, status])
  @@index([listId, category])
  @@index([listId, sortOrder])
  @@map("order_list_items")
}

model PrintJob {
  id          String    @id @default(uuid())
  listId      String
  storeId     String    // denormalized for easy queries
  printedById String
  notes       String?
  itemCount   Int
  printedAt   DateTime  @default(now())

  list      OrderList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  printedBy User         @relation("PrintJobsPrinted", fields: [printedById], references: [id])
  items     PrintJobItem[]

  @@index([listId, printedAt])
  @@index([storeId, printedAt])
  @@map("print_jobs")
}

model PrintJobItem {
  id         String        @id @default(uuid())
  printJobId String
  listItemId String
  snapshot   Json          // {name, quantity, category, notes, priority} at print time

  printJob PrintJob      @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  listItem OrderListItem @relation(fields: [listItemId], references: [id])

  @@map("print_job_items")
}

model EmployeeItemRequest {
  id            String                @id @default(uuid())
  storeId       String
  submittedById String
  status        EmployeeRequestStatus @default(PENDING)
  note          String?               // Employee's optional message
  requestType   EmployeeRequestType   @default(LOW_STOCK)
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime              @default(now())

  store       Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  submittedBy User                   @relation("EmployeeRequestsSubmitted", fields: [submittedById], references: [id])
  reviewedBy  User?                  @relation("EmployeeRequestsReviewed", fields: [reviewedById], references: [id])
  lines       EmployeeRequestLine[]

  @@index([storeId, status])
  @@index([submittedById])
  @@map("employee_item_requests")
}

model EmployeeRequestLine {
  id              String           @id @default(uuid())
  requestId       String
  name            String
  quantity        String?
  category        String?
  notes           String?
  status          RequestLineStatus @default(PENDING)
  rejectionReason RejectionReason?  // predefined reason
  rejectionNote   String?           // free-text explanation
  reviewedAt      DateTime?

  request  EmployeeItemRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  listItem OrderListItem?      // populated via OrderListItem.requestLineId when accepted

  @@map("employee_request_lines")
}

model OrderCategory {
  id           String         @id @default(uuid())
  name         String
  storeId      String?        // null = global / chain-wide
  usageCount   Int            @default(1)
  status       CategoryStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())

  approvedBy User? @relation("CategoryApprovals", fields: [approvedById], references: [id])

  @@unique([name, storeId])
  @@index([status, usageCount])
  @@map("order_categories")
}

// ─── Points Dispute ───────────────────────────────────────────────────────────

enum DisputeStatus {
  PENDING
  APPROVED
  REJECTED
}

model PointsDispute {
  id            String        @id @default(uuid())
  customerId    String
  storeId       String
  description   String
  estimatedAmt  Float?
  status        DisputeStatus @default(PENDING)
  resolvedById  String?
  resolvedNote  String?
  creditedAmt   Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer      User          @relation("DisputeSubmitter", fields: [customerId], references: [id], onDelete: Cascade)
  store         Store         @relation(fields: [storeId], references: [id])
  resolvedBy    User?         @relation("DisputeResolver", fields: [resolvedById], references: [id])

  @@index([storeId, status])
  @@index([customerId])
  @@map("points_disputes")
}
